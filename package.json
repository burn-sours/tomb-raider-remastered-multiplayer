{
    "name": "tomb-raider-remastered-launcher",
    "version": "2.3.1",
    "description": "Burn's Mods & Multiplayer for TRR I-V",
    "license": "GPL-3.0-only",
    "author": "burn_sours",
    "main": "client/index.js",
    "scripts": {
        "start-server": "node server/index.js",
        "start-discord": "node server/discord-bot.js",
        "init-discord": "node server/discord-bot.js --init",
        "start-client": "electron client/index.js",
        "deploy": "node ./deploy.js"
    },
    "dependencies": {
        "discord.js": "^14.25.1",
        "frida": "^17.7.3",
        "zstd-codec": "^0.1.5"
    },
    "gypfile": true,
    "devDependencies": {
        "@types/frida-gum": "^19.0.2",
        "@yao-pkg/pkg": "^6.14.1",
        "electron": "^40.8.0",
        "electron-builder": "^26.8.1",
        "resedit": "^2.0.3"
    },
    "pkg": {
        "assets": [
            "shared/**/*",
            "server/**/*.js"
        ],
        "scripts": [
            "shared/**/*.js",
            "server/**/*.js"
        ]
    },
    "build": {
        "appId": "com.laracrofts.launcher",
        "productName": "Burn's Mods Launcher",
        "copyright": "Copyright © 2026 burn_sours",
        "files": [
            "client/**/*",
            "shared/**/*",
            "*.ico",
            "node_modules/frida/build/frida_binding.node",
            "node_modules/frida/package.json"
        ],
        "directories": {
            "output": "releases"
        },
        "win": {
            "signtoolOptions": {
                "publisherName": "burn_sours"
            },
            "target": [
                "nsis"
            ],
            "icon": "client/ui/images/burn_256.png"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "differentialPackage": false
        }
    }
}